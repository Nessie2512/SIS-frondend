{
  "name": "schoolie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/main.tsx",
    "./src/shared/i18n/index.ts"
  ],
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build && node scripts/mensagens-compiladas.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project unidade",
    "test:run": "vitest run --project unidade",
    "test:storybook": "vitest run --project storybook",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "deps:check": "depcruise src",
    "api:baixar": "node scripts/baixar-openapi.mjs",
    "api:gen": "openapi-typescript ./openapi.json -o src/shared/api/sis/schema.d.ts",
    "api:amostras": "node scripts/amostras-api.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm deps:check && pnpm contraste",
    "contraste": "node scripts/contraste.mjs",
    "tamanho": "size-limit",
    "i18n:extrair": "lingui extract --clean",
    "fontes": "node -e \"require('node:fs').copyFileSync('node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2', 'public/fonts/inter-latin-wght-normal.woff2')\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@sentry/react": "11.7.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@lingui/babel-plugin-lingui-macro": "6.9.1",
    "@lingui/cli": "6.9.1",
    "@lingui/conf": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@size-limit/file": "14.2.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.46",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lingui": "0.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "14.2.0",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.4",
    "workbox-window": "7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
