# Copia para .env.local e ajusta.
# true = a API é simulada no navegador pelo MSW (útil enquanto não há backend/schema)
VITE_API_MOCK=false

# Observabilidade (só em produção). Sem DSN, o Sentry não é iniciado.
VITE_SENTRY_DSN=
VITE_VERSAO=
# Endpoint opcional para as Core Web Vitals (POST via sendBeacon)
VITE_VITAIS_URL=

# Ligação faseada ao backend SIS (guia 4.3). Áreas na API real, separadas por vírgulas,
# ou "todas": sessao, anos, curriculo, turmas, estudantes, professores, utilizadores
# Sem esta variável, `pnpm dev` usa o contrato provisório /api/v1 (que só existe no MSW).
# Localmente, para a sessão contra o backend SIS: VITE_API_REAL=sessao (ou todas).
VITE_API_REAL=

# Destino do proxy /sis em desenvolvimento (por omissão http://localhost:3000).
# Só é preciso mudar para apontar o frontend local a outro servidor SIS.
# O staging não usa esta variável: no Render, a reescrita /sis/* de render.yaml trata disso.
SIS_URL=
