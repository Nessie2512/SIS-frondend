# Copia para .env.local e ajusta.
# true = a API é simulada no navegador pelo MSW (útil enquanto não há backend/schema)
VITE_API_MOCK=false

# Observabilidade (só em produção). Sem DSN, o Sentry não é iniciado.
VITE_SENTRY_DSN=
VITE_VERSAO=
# Endpoint opcional para as Core Web Vitals (POST via sendBeacon)
VITE_VITAIS_URL=
VITE_API_URL=http://localhost:3000
