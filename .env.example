# Copia para .env.local e ajusta.
# Observabilidade (só em produção). Sem DSN, o Sentry não é iniciado.
VITE_SENTRY_DSN=
VITE_VERSAO=
# Endpoint opcional para as Core Web Vitals (POST via sendBeacon)
VITE_VITAIS_URL=

# Caminho same-origin da API no browser; o proxy local e a rewrite do Render usam /sis.
VITE_SIS_BASE=/sis

# Destino do proxy /sis no desenvolvimento local.
SIS_URL=http://localhost:3000
